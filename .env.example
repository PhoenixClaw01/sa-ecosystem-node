# Public endpoints only. Do not put private keys, keypairs, or API secrets here.

# Star Atlas SAGE C4 test realm (z.ink). Safe default if unset.
ZINK_RPC_URL=https://testnet-rpc.z.ink

# Public Solana JSON-RPC. Read methods only (no send, no sign). Safe default if unset.
# publicnode answers browser reads. Point this at your own RPC to host the node anywhere.
SOLANA_RPC_URL=https://solana-rpc.publicnode.com
# Tried, in order, when the primary URL refuses the read. Comma-separated. Safe default if unset.
# SOLANA_RPC_FALLBACK_URLS=https://api.mainnet-beta.solana.com

# Public galaxy JSON. Safe default if unset.
# GALAXY_BASE_URL=https://galaxy.staratlas.com

# Signed hub updates. Leave these unset and hub_updates returns no rows.
# The repo is a public https git URL, or an absolute local path for testing.
# A host with git checks out HUB_GIT_COMMIT. A host without git, including Vercel,
# downloads a public github.com repository at that commit over HTTPS.
# The commit and the manifest sha256 must both match.
# Content integrity comes from the commit pin plus signatures. The manifest hash covers the file list.
# HUB_GIT_REPO=
# HUB_GIT_COMMIT=
# Unset, the server reads hub-manifest.json. If that file is missing, it reads manifest.json.
# The pinned hash must match the file that was read. Setting this selects one path and does not try the other name.
# HUB_STORE_MANIFEST=
# HUB_STORE_MANIFEST_HASH=
# Distinct allowlisted approval signatures required for each update.
# The example stays at 1 for the testnet dry run. The author's own approval counts, and the result is selfApproved when that key is the only approver.
# Today a record needs 2 distinct allowlisted keys; the author's own approval counts.
# The public deployment sets HUB_APPROVAL_THRESHOLD=2 and HUB_ALLOW_AUTHOR_APPROVAL=true (Phoenix Collective, plus Falkor FC1e).
# GaliaMeta DAC stays on the allowlist and is not required for that pair.
# HUB_APPROVAL_THRESHOLD=1
# HUB_ALLOW_AUTHOR_APPROVAL=false
# Local revoked signer public keys. Comma-separated base58 addresses, or a JSON array.
# Takes effect when the process loads config. The key can remain in hub/signers.json.
# An update whose only valid approvals are from these keys is revoked_signer.
# This is not a signer-group revocation. Revoking a whole signer group is not implemented.
# HUB_REVOKED_SIGNERS=
# Verifier public keys. An attestation from one of these keys is verified.
# Any other attestation stays self-attested. Empty by default. Same list shape as HUB_REVOKED_SIGNERS.
# HUB_TRUSTED_VERIFIERS=
# Optional Discord verifier for operators. Leave unset and the node still runs.
# Set all three only on a machine that issues attestations. Do not commit the secret.
# The scope is identify only. Register the app at https://discord.com/developers/applications.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://127.0.0.1:8788/discord
# Allowlist of labeled ed25519 public keys (agent record keys or wallets). hub/signers.json ships with three testnet public keys.
# An empty list rejects every update.
# HUB_SIGNERS_PATH=hub/signers.json
# Optional JSON array of signer sets this node trusts. Env overrides node.config.json.
# HUB_SIGNER_SETS=[{"id":"default","path":"hub/signers.json","threshold":1}]

# One config file for every run mode. Copy node.config.example.json to node.config.json.
# Env values below override the file. Do not commit node.config.json.
# NODE_CONFIG=node.config.json

# Local cache written by `npm run refresh-treasury` and read by the treasury tools.
# TREASURY_CACHE_PATH=data/treasury-cache.json

# Local Streamable HTTP bind. Loopback only is the safe default.
HOST=127.0.0.1
PORT=8787

# In-memory per instance. Not shared across instances. A restart clears the buckets.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Public Node server (Docker, Railway, Fly, Render). Loopback npm start leaves these unset.
# PUBLIC_NODE=1
# Empty allowedHosts, or *, refuses to start unless this opt-in is set. The process then warns.
# Deploy templates leave this unset. Set ALLOWED_HOSTS to the served hostname instead.
# ALLOW_ANY_HOST=1
# Trust X-Forwarded-For only behind a proxy that overwrites it. Vercel configs set this.
# Fly and Render append to the header, so leave this unset there. The key stays the socket address.
# TRUST_PROXY=1
# ALLOWED_HOSTS=your-app.fly.dev
# MAX_REQUEST_BYTES=524288
# MAX_RESPONSE_BYTES=524288
